# 复制为 .env 后填写。不要把真实密钥提交到 Git。
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
PGHOST=127.0.0.1
PGPORT=5432
DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/mydb

# openai_compatible | ollama | mock
# mock 仅用于测试和离线开发，界面与日志必须显式显示。
# 本机推荐独立 conda 环境启动 vLLM：scripts/start_vllm.sh
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=Qwen3.8-27B-FP8

# local | openai_compatible | ollama | mock
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=models/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_DEVICE=cpu

RERANKER_ENABLED=false
RERANKER_MODEL=models/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=20
RERANK_TOP_N=8

UPLOAD_DIR=data/uploads
ARTIFACT_DIR=data/artifacts
API_BASE_URL=http://127.0.0.1:8000
APP_ENV=development
LOG_LEVEL=INFO
DEMO_USER_ID=demo-user
# 当前组来自演示登录所选部门（algorithm / framework / testing）。
# 公共组固定为 public，不要在生成请求里传递组 ID。
